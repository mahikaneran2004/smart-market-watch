NODE_ENV=development
PORT=8000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/utd?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
# CORS Allowed Origins: comma-separated list of allowed origins (e.g. https://trader.example.com,https://app.example.com)
CORS_ORIGIN=http://localhost:3000
MARKET_DATA_MODE=mock
KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=http://localhost:8000/broker/kite/callback
KITE_TOKEN_ENCRYPTION_KEY=
# KITE_SYNC_USER_ID: UUID of an authenticated Kite user to sync the instrument catalog on startup (kite mode only).
KITE_SYNC_USER_ID=
# Evaluator/Demo seed account credentials (for npm run prisma:seed):
SEED_EMAIL=demo@example.com
SEED_PASSWORD=ChangeMe123!
# Optional dev-only override (ignored when NODE_ENV=production):
# FORCE_MARKET_OPEN=false
