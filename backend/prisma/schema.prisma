generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  createdAt     DateTime @default(now())
  refreshTokens RefreshToken[]
  trades        Trade[]
  alerts        Alert[]
  holdings      Holding[]
  auditLogs     AuditLog[]
  watchlist     WatchlistItem[]
  brokerSessions BrokerSession[]
  portfolioAccount PortfolioAccount?
  ledgerEntries CashLedgerEntry[]
  positions     Position[]
  riskSettings  RiskSettings?
  signals       Signal[]
  tradeJournals TradeJournal[]
  alertNotifications AlertNotification[]
}


model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  user      User     @relation(fields: [userId], references: [id])
  userId    String
}

model Trade {
  id        String   @id @default(uuid())
  symbol    String
  qty       Int
  price     Decimal  @db.Decimal(20, 8)
  side      String
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
}

model Alert {
  id        String   @id @default(uuid())
  symbol    String
  condition String
  value     Float
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
}

model Holding {
  id        String   @id @default(uuid())
  symbol    String
  qty       Int
  avg       Decimal  @db.Decimal(20, 8)
  user      User     @relation(fields: [userId], references: [id])
  userId    String

  @@unique([userId, symbol])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model Event {
  id          String    @id @default(uuid())
  type        String
  source      String
  externalId  String?
  payload     Json
  occurredAt  DateTime?
  ingestedAt  DateTime  @default(now())
  processedAt DateTime?
  status      String    @default("PENDING")
  error       String?

  @@unique([source, externalId])
  @@index([status, ingestedAt])
}

model Job {
  id          String    @id @default(uuid())
  type        String
  status      String    @default("PENDING")
  payload     Json?
  attempts    Int       @default(0)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  completedAt DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
}

model WatchlistItem {
  id        String   @id @default(uuid())
  symbol    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([userId, symbol])
  @@index([userId, createdAt])
}

model BrokerSession {
  id                   String   @id @default(uuid())
  provider             String   @default("ZERODHA")
  brokerUserId         String?
  accessTokenEncrypted String
  profile              Json?
  expiresAt            DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String

  @@unique([userId, provider])
  @@index([provider, expiresAt])
}

model PortfolioAccount {
  id             String   @id @default(uuid())
  userId         String   @unique
  cashBalance    Decimal  @default(1000000) @db.Decimal(20, 8)
  reservedMargin Decimal  @default(0) @db.Decimal(20, 8)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CashLedgerEntry {
  id           String   @id @default(uuid())
  userId       String
  amount       Decimal  @db.Decimal(20, 8)
  balanceAfter Decimal  @db.Decimal(20, 8)
  realizedPnl  Decimal? @db.Decimal(20, 8)
  reason       String
  tradeId      String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Instrument {
  id             String   @id @default(uuid())
  instrumentToken Int
  exchangeToken  Int?
  tradingsymbol  String
  name           String?
  lastPrice      Decimal? @db.Decimal(20, 8)
  expiry         DateTime?
  strike         Decimal? @db.Decimal(20, 8)
  tickSize       Decimal  @db.Decimal(20, 8)
  lotSize        Int
  instrumentType String
  segment        String
  exchange       String
  syncedAt       DateTime @default(now())

  @@unique([exchange, tradingsymbol])
  @@index([tradingsymbol])
  @@index([name])
  @@index([instrumentToken])
}

model Position {
  id             String   @id @default(uuid())
  userId         String
  exchange       String
  symbol         String
  product        String
  instrumentToken Int
  quantity       Int
  averagePrice   Decimal  @db.Decimal(20, 8)
  lastPrice      Decimal  @db.Decimal(20, 8)
  pnl            Decimal  @db.Decimal(20, 8)
  m2m            Decimal  @db.Decimal(20, 8)
  unrealized     Decimal  @db.Decimal(20, 8)
  realized       Decimal  @db.Decimal(20, 8)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, exchange, symbol, product])
  @@index([userId, updatedAt])
}

model RiskSettings {
  id                   String   @id @default(uuid())
  userId               String   @unique
  maxDailyLoss         Decimal  @default(50000) @db.Decimal(20, 8) // Max loss in INR before auto-freeze
  maxPositionSize      Decimal  @default(200000) @db.Decimal(20, 8) // Max single trade value in INR
  maxSectorExposurePct Float    @default(35.0) // Max % of portfolio in a single sector
  killSwitchActive     Boolean  @default(false) // Emergency kill switch to block orders
  stopLossDefaultPct   Float    @default(2.0) // Default SL % for bracket orders
  takeProfitDefaultPct Float    @default(4.0) // Default TP % for bracket orders
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Signal {
  id              String   @id @default(uuid())
  userId          String?
  symbol          String
  direction       String   // "BULLISH", "BEARISH", "NEUTRAL"
  compositeScore  Float    // -1.0 to +1.0
  technicalScore  Float?   // -1.0 to +1.0
  sentimentScore  Float?   // -1.0 to +1.0
  macroScore      Float?   // -1.0 to +1.0
  confidence      Float    @default(0.7)
  horizon         String   // "INTRADAY", "SWING", "POSITIONAL"
  rationale       String
  keyFactors      Json?
  status          String   @default("ACTIVE") // "ACTIVE", "EXPIRED", "EXECUTED"
  createdAt       DateTime @default(now())
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([symbol, createdAt])
  @@index([status, createdAt])
}

model TradeJournal {
  id             String   @id @default(uuid())
  userId         String
  tradeId        String?
  symbol         String
  side           String
  qty            Int
  price          Decimal  @db.Decimal(20, 8)
  strategyTag    String?  // "MOMENTUM_BREAKOUT", "MEAN_REVERSION", "NEWS_CATALYST"
  conviction     Int      @default(3) // 1 to 5 stars
  notes          String?
  setupSnapshot  Json?    // Technical indicators (RSI, SMA, LTP) at time of trade
  pnlRealized    Decimal? @db.Decimal(20, 8)
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, symbol])
  @@index([userId, createdAt])
}

model AlertNotification {
  id           String   @id @default(uuid())
  userId       String
  alertId      String?
  symbol       String
  channel      String   // "IN_APP", "TELEGRAM", "WEBHOOK", "EMAIL"
  title        String
  message      String
  status       String   @default("DELIVERED") // "DELIVERED", "FAILED", "SUPPRESSED_COOLDOWN"
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([symbol, createdAt])
}

